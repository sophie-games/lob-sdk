  "locales": {
    "en": {
      "name": "Apennine Ridges",
      "description": "A steep ridge crowned with redoubts and a castle rises between the armies."
    },
    "es": {
      "name": "Crestas apeninas",
      "description": "Una cresta empinada, coronada de reductos y un castillo, se alza entre los ej\u00e9rcitos."
    },
    "fr": {
      "name": "Cr\u00eates des Apennins",
      "description": "Une cr\u00eate escarp\u00e9e, couronn\u00e9e de redoutes et d'un ch\u00e2teau, se dresse entre les arm\u00e9es."
    },
    "de": {
      "name": "Apenninenkamm",
      "description": "Ein steiler Kamm, gekr\u00f6nt von Redouten und einer Burg, erhebt sich zwischen den Armeen."
    },
    "it": {
      "name": "Crinali appenninici",
      "description": "Un crinale ripido, coronato da ridotte e da un castello, si innalza tra gli eserciti."
    },
    "pt": {
      "name": "Cristas apeninas",
      "description": "Uma crista \u00edngreme, coroada de redutos e de um castelo, ergue-se entre os ex\u00e9rcitos."
    },
    "ru": {
      "name": "\u0410\u043f\u0435\u043d\u043d\u0438\u043d\u0441\u043a\u0438\u0435 \u0445\u0440\u0435\u0431\u0442\u044b",
      "description": "\u041c\u0435\u0436\u0434\u0443 \u0430\u0440\u043c\u0438\u044f\u043c\u0438 \u0432\u043e\u0437\u0432\u044b\u0448\u0430\u0435\u0442\u0441\u044f \u043a\u0440\u0443\u0442\u043e\u0439 \u0445\u0440\u0435\u0431\u0435\u0442, \u0443\u0432\u0435\u043d\u0447\u0430\u043d\u043d\u044b\u0439 \u0440\u0435\u0434\u0443\u0442\u0430\u043c\u0438 \u0438 \u0437\u0430\u043c\u043a\u043e\u043c."
    },
    "uk": {
      "name": "\u0410\u043f\u0435\u043d\u043d\u0456\u043d\u0441\u044c\u043a\u0456 \u0445\u0440\u0435\u0431\u0442\u0438",
      "description": "\u041c\u0456\u0436 \u0430\u0440\u043c\u0456\u044f\u043c\u0438 \u0437\u0434\u0456\u0439\u043c\u0430\u0454\u0442\u044c\u0441\u044f \u043a\u0440\u0443\u0442\u0438\u0439 \u0445\u0440\u0435\u0431\u0435\u0442, \u0443\u0432\u0456\u043d\u0447\u0430\u043d\u0438\u0439 \u0440\u0435\u0434\u0443\u0442\u0430\u043c\u0438 \u0442\u0430 \u0437\u0430\u043c\u043a\u043e\u043c."
    },
    "pl": {
      "name": "Grzbiety Apenin\u00f3w",
      "description": "Mi\u0119dzy armiami wznosi si\u0119 stromy grzbiet zwie\u0144czony redutami i zamkiem."
    },
    "hu": {
      "name": "Appennini gerincek",
      "description": "A seregek k\u00f6z\u00f6tt meredek gerinc emelkedik, tetej\u00e9n s\u00e1ncokkal \u00e9s egy v\u00e1rral."
    },
    "el": {
      "name": "\u039a\u03bf\u03c1\u03c5\u03c6\u03bf\u03b3\u03c1\u03b1\u03bc\u03bc\u03ad\u03c2 \u03c4\u03c9\u03bd \u0391\u03c0\u03b5\u03bd\u03bd\u03af\u03bd\u03c9\u03bd",
      "description": "\u039c\u03b9\u03b1 \u03b1\u03c0\u03cc\u03c4\u03bf\u03bc\u03b7 \u03ba\u03bf\u03c1\u03c5\u03c6\u03bf\u03b3\u03c1\u03b1\u03bc\u03bc\u03ae, \u03bc\u03b5 \u03bf\u03c7\u03c5\u03c1\u03ce\u03bc\u03b1\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03ad\u03bd\u03b1 \u03ba\u03ac\u03c3\u03c4\u03c1\u03bf \u03c3\u03c4\u03b7\u03bd \u03ba\u03bf\u03c1\u03c5\u03c6\u03ae, \u03c5\u03c8\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b1\u03bd\u03ac\u03bc\u03b5\u03c3\u03b1 \u03c3\u03c4\u03bf\u03c5\u03c2 \u03c3\u03c4\u03c1\u03b1\u03c4\u03bf\u03cd\u03c2."
    },
    "tr": {
      "name": "Apenin S\u0131rtlar\u0131",
      "description": "Ordular aras\u0131nda, tabyalar ve bir kaleyle ta\u00e7lanm\u0131\u015f dik bir s\u0131rt y\u00fckselir."
    },
    "ar": {
      "name": "\u062d\u0648\u0627\u0641 \u0627\u0644\u0623\u0628\u0646\u064a\u0646",
      "description": "\u062a\u0631\u062a\u0641\u0639 \u0628\u064a\u0646 \u0627\u0644\u062c\u064a\u0634\u064a\u0646 \u062d\u0627\u0641\u0629 \u0634\u062f\u064a\u062f\u0629 \u0627\u0644\u0627\u0646\u062d\u062f\u0627\u0631 \u062a\u0639\u0644\u0648\u0647\u0627 \u0645\u0639\u0627\u0642\u0644 \u0648\u0642\u0644\u0639\u0629."
    },
    "hi": {
      "name": "\u090f\u092a\u0947\u0928\u093e\u0907\u0928 \u092a\u0930\u094d\u0935\u0924\u0936\u094d\u0930\u0947\u0923\u0940",
      "description": "\u0938\u0947\u0928\u093e\u0913\u0902 \u0915\u0947 \u092c\u0940\u091a \u090f\u0915 \u0916\u0921\u093c\u0940 \u092a\u0939\u093e\u0921\u093c\u0940 \u0909\u0920\u0924\u0940 \u0939\u0948, \u091c\u093f\u0938\u0915\u0947 \u0936\u093f\u0916\u0930 \u092a\u0930 \u092e\u094b\u0930\u094d\u091a\u0947 \u0914\u0930 \u090f\u0915 \u0915\u093f\u0932\u093e \u0939\u0948\u0902\u0964"
    },
    "id": {
      "name": "Punggung Apennine",
