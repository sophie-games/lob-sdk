  "locales": {
    "en": {
      "name": "Walled City",
      "description": "A city with stone walls and narrow streets, surrounded by villages and fields."
    },
    "es": {
      "name": "Ciudad amurallada",
      "description": "Una ciudad con murallas de piedra y calles estrechas, rodeada de aldeas y campos."
    },
    "fr": {
      "name": "Ville fortifiée",
      "description": "Une ville aux murailles de pierre et aux rues étroites, entourée de villages et de champs."
    },
    "de": {
      "name": "Ummauerte Stadt",
      "description": "Eine Stadt mit Steinmauern und engen Gassen, umgeben von Dörfern und Feldern."
    },
    "it": {
      "name": "Città murata",
      "description": "Una città con mura di pietra e strade strette, circondata da villaggi e campi."
    },
    "pt": {
      "name": "Cidade Murada",
      "description": "Uma cidade com muralhas de pedra e ruas estreitas, cercada por aldeias e campos."
    },
    "ru": {
      "name": "Город-крепость",
      "description": "Город с каменными стенами и узкими улицами, окружённый деревнями и полями."
    },
    "uk": {
      "name": "Місто-фортеця",
      "description": "Місто з кам'яними стінами та вузькими вулицями, оточене селами й полями."
    },
    "pl": {
      "name": "Miasto warowne",
      "description": "Miasto z kamiennymi murami i wąskimi uliczkami, otoczone wioskami i polami."
    },
    "hu": {
      "name": "Fallal körülvett város",
      "description": "Kőfalakkal és szűk utcákkal teli város, körülötte falvak és mezők."
    },
    "el": {
      "name": "Τειχισμένη πόλη",
      "description": "Μια πόλη με πέτρινα τείχη και στενά δρομάκια, περιτριγυρισμένη από χωριά και χωράφια."
    },
    "tr": {
      "name": "Surlu Şehir",
      "description": "Taş surları ve dar sokakları olan, köyler ve tarlalarla çevrili bir şehir."
    },
    "ar": {
      "name": "المدينة المسوّرة",
      "description": "مدينة ذات أسوار حجرية وشوارع ضيقة، تحيط بها القرى والحقول."
    },
    "hi": {
      "name": "परकोटे वाला शहर",
      "description": "पत्थर की दीवारों और संकरी गलियों वाला शहर, जो गाँवों और खेतों से घिरा है।"
    },
    "id": {
      "name": "Kota Bertembok",
      "description": "Kota bertembok batu dengan jalan-jalan sempit, dikelilingi desa dan ladang."
    },
    "th": {
      "name": "เมืองกำแพง",
      "description": "เมืองที่มีกำแพงหินและถนนแคบ ล้อมรอบด้วยหมู่บ้านและทุ่งนา"
    },
    "vi": {
      "name": "Thành phố có tường thành",
      "description": "Một thành phố với tường đá và những con phố hẹp, bao quanh bởi làng mạc và đồng ruộng."
    },
    "ja": {
      "name": "城壁都市",
      "description": "石の城壁と狭い路地を持つ都市。周囲には村と畑が広がる。"
    },
    "kr": {
      "name": "성곽 도시",
      "description": "돌 성벽과 좁은 골목을 지닌 도시로, 마을과 들판에 둘러싸여 있습니다."
    },
    "zh": {
      "name": "城墙都市",
      "description": "一座拥有石砌城墙和狭窄街道的城市，四周环绕着村庄和田野。"
    }
  }
}
