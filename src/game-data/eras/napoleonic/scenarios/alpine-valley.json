    "kr": {
      "name": "\uc54c\ud504\uc2a4 \uacc4\uace1",
      "description": "\uc0b0\ubcbd \uc0ac\uc774\uc758 \uc881\uc740 \uacc4\uace1. \uac15\uacfc \uae38 \ud558\ub098\uac00 \uc9c0\ub098\uba70 \uc911\uac04\uc5d0 \ud611\uace1\uc73c\ub85c \uc881\uc544\uc9c4\ub2e4."
