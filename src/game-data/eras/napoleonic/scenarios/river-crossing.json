      "name": "Cruce del r\u00edo",
      "description": "Un r\u00edo profundo divide el campo: cr\u00fazalo por los puentes, defendidos por aldeas, o por el vado."
    },
    "fr": {
      "name": "Passage de la rivi\u00e8re",
      "description": "Une rivi\u00e8re profonde coupe le champ de bataille : franchissez-la aux ponts, tenus par des villages, ou au gu\u00e9."
    },
    "de": {
      "name": "Fluss\u00fcbergang",
      "description": "Ein tiefer Fluss teilt das Schlachtfeld: \u00dcberquere ihn an den von D\u00f6rfern gehaltenen Br\u00fccken oder an der Furt."
    },
    "it": {
      "name": "Guado del fiume",
      "description": "Un fiume profondo divide il campo: attraversalo sui ponti, difesi dai villaggi, o al guado."
