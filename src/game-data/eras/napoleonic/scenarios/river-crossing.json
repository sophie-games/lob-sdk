    "ru": {
      "name": "\u041f\u0435\u0440\u0435\u043f\u0440\u0430\u0432\u0430",
      "description": "\u0413\u043b\u0443\u0431\u043e\u043a\u0430\u044f \u0440\u0435\u043a\u0430 \u0434\u0435\u043b\u0438\u0442 \u043f\u043e\u043b\u0435 \u0431\u043e\u044f: \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442\u0435 \u0435\u0451 \u043f\u043e \u043c\u043e\u0441\u0442\u0430\u043c, \u043f\u0440\u0438\u043a\u0440\u044b\u0442\u044b\u043c \u0434\u0435\u0440\u0435\u0432\u043d\u044f\u043c\u0438, \u0438\u043b\u0438 \u0432\u0431\u0440\u043e\u0434."
    },
    "uk": {
      "name": "\u041f\u0435\u0440\u0435\u043f\u0440\u0430\u0432\u0430",
      "description": "\u0413\u043b\u0438\u0431\u043e\u043a\u0430 \u0440\u0456\u0447\u043a\u0430 \u0434\u0456\u043b\u0438\u0442\u044c \u043f\u043e\u043b\u0435 \u0431\u043e\u044e: \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044c\u0442\u0435 \u0457\u0457 \u043c\u043e\u0441\u0442\u0430\u043c\u0438, \u043f\u0440\u0438\u043a\u0440\u0438\u0442\u0438\u043c\u0438 \u0441\u0435\u043b\u0430\u043c\u0438, \u0430\u0431\u043e \u0432\u0431\u0440\u0456\u0434."
    },
    "pl": {
      "name": "Przeprawa przez rzek\u0119",
      "description": "G\u0142\u0119boka rzeka dzieli pole bitwy: przekrocz j\u0105 po mostach, bronionych przez wsie, lub w brodzie."
    },
    "hu": {
      "name": "Folyami \u00e1tkel\u00e9s",
      "description": "M\u00e9ly foly\u00f3 szeli kett\u00e9 a csatateret: kelj \u00e1t a falvak v\u00e9dte hidakon vagy a g\u00e1zl\u00f3n."
    },
    "el": {
      "name": "\u0394\u03b9\u03ac\u03b2\u03b1\u03c3\u03b7 \u03c0\u03bf\u03c4\u03b1\u03bc\u03bf\u03cd",
      "description": "\u0388\u03bd\u03b1 \u03b2\u03b1\u03b8\u03cd \u03c0\u03bf\u03c4\u03ac\u03bc\u03b9 \u03c7\u03c9\u03c1\u03af\u03b6\u03b5\u03b9 \u03c4\u03bf \u03c0\u03b5\u03b4\u03af\u03bf: \u03c0\u03b5\u03c1\u03ac\u03c3\u03c4\u03b5 \u03c4\u03bf \u03b1\u03c0\u03cc \u03c4\u03b9\u03c2 \u03b3\u03ad\u03c6\u03c5\u03c1\u03b5\u03c2, \u03c0\u03bf\u03c5 \u03c4\u03b9\u03c2 \u03ba\u03c1\u03b1\u03c4\u03bf\u03cd\u03bd \u03c7\u03c9\u03c1\u03b9\u03ac, \u03ae \u03b1\u03c0\u03cc \u03c4\u03bf \u03c0\u03ad\u03c1\u03b1\u03c3\u03bc\u03b1."
    },
    "tr": {
      "name": "Nehir Ge\u00e7i\u015fi",
      "description": "Derin bir nehir sava\u015f alan\u0131n\u0131 ikiye b\u00f6ler: k\u00f6ylerin tuttu\u011fu k\u00f6pr\u00fclerden ya da s\u0131\u011f ge\u00e7itten ge\u00e7in."
    },
    "ar": {
      "name": "\u0639\u0628\u0648\u0631 \u0627\u0644\u0646\u0647\u0631",
      "description": "\u0646\u0647\u0631 \u0639\u0645\u064a\u0642 \u064a\u0642\u0633\u0645 \u0627\u0644\u0645\u064a\u062f\u0627\u0646: \u0627\u0639\u0628\u0631\u0647 \u0639\u0646\u062f \u0627\u0644\u062c\u0633\u0648\u0631 \u0627\u0644\u062a\u064a \u062a\u062d\u0645\u064a\u0647\u0627 \u0627\u0644\u0642\u0631\u0649\u060c \u0623\u0648 \u0639\u0646\u062f \u0627\u0644\u0645\u062e\u0627\u0636\u0629."
    },
    "hi": {
      "name": "\u0928\u0926\u0940 \u092a\u093e\u0930",
      "description": "\u090f\u0915 \u0917\u0939\u0930\u0940 \u0928\u0926\u0940 \u092e\u0948\u0926\u093e\u0928 \u0915\u094b \u092c\u093e\u0901\u091f\u0924\u0940 \u0939\u0948: \u0907\u0938\u0947 \u0917\u093e\u0901\u0935\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u0941\u0932\u094b\u0902 \u0938\u0947 \u092f\u093e \u0918\u093e\u091f \u0938\u0947 \u092a\u093e\u0930 \u0915\u0930\u0947\u0902\u0964"
    },
    "id": {
      "name": "Penyeberangan Sungai",
      "description": "Sungai yang dalam membelah medan: seberangi lewat jembatan yang dijaga desa, atau lewat arungan."
    },
    "th": {
      "name": "\u0e02\u0e49\u0e32\u0e21\u0e41\u0e21\u0e48\u0e19\u0e49\u0e33",
      "description": "\u0e41\u0e21\u0e48\u0e19\u0e49\u0e33\u0e25\u0e36\u0e01\u0e41\u0e1a\u0e48\u0e07\u0e2a\u0e19\u0e32\u0e21\u0e23\u0e1a: \u0e02\u0e49\u0e32\u0e21\u0e17\u0e32\u0e07\u0e2a\u0e30\u0e1e\u0e32\u0e19\u0e17\u0e35\u0e48\u0e21\u0e35\u0e2b\u0e21\u0e39\u0e48\u0e1a\u0e49\u0e32\u0e19\u0e04\u0e38\u0e49\u0e21\u0e01\u0e31\u0e19 \u0e2b\u0e23\u0e37\u0e2d\u0e17\u0e32\u0e07\u0e17\u0e48\u0e32\u0e02\u0e49\u0e32\u0e21\u0e19\u0e49\u0e33\u0e15\u0e37\u0e49\u0e19"
    },
    "vi": {
      "name": "V\u01b0\u1ee3t s\u00f4ng",
      "description": "M\u1ed9t con s\u00f4ng s\u00e2u chia \u0111\u00f4i chi\u1ebfn tr\u01b0\u1eddng: v\u01b0\u1ee3t qua \u1edf nh\u1eefng c\u00e2y c\u1ea7u c\u00f3 l\u00e0ng gi\u1eef, ho\u1eb7c \u1edf ch\u1ed7 l\u1ed9i."
    },
    "ja": {
      "name": "\u6e21\u6cb3",
      "description": "\u6df1\u3044\u5ddd\u304c\u6226\u5834\u3092\u5206\u65ad\u3059\u308b\u3002\u6751\u304c\u5b88\u308b\u6a4b\u304b\u3001\u6d45\u702c\u3067\u6e21\u308c\u3002"
    },
    "kr": {
      "name": "\ub3c4\ud558",
      "description": "\uae4a\uc740 \uac15\uc774 \uc804\uc7a5\uc744 \uac00\ub978\ub2e4. \ub9c8\uc744\uc774 \uc9c0\ud0a4\ub294 \ub2e4\ub9ac\ub098 \uc5ec\uc6b8\ub85c \uac74\ub108\ub77c."
